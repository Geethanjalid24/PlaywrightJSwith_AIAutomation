# Copy this file to .env and fill in real values. Never commit .env with real secrets.

BASE_URL=https://opensource-demo.orangehrmlive.com
OHRM_USERNAME=Admin
OHRM_PASSWORD=admin123

# ReqRes.in is a free public API used to simulate the API validation layer.
# No key is strictly required for reqres.in's demo endpoints, but if you swap in a
# real OrangeHRM API or another provider, put the credentials here.
API_BASE_URL=https://reqres.in/api
API_KEY=
